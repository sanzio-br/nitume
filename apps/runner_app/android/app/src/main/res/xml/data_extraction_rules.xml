<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup rules (android:dataExtractionRules). Evidence photos
     waiting to upload offline (getFilesDir()/nitume_evidence) stay out of
     both cloud backup and device-to-device transfer (owner row 255). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="nitume_evidence"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="nitume_evidence"/>
    </device-transfer>
</data-extraction-rules>
