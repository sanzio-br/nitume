# --- App ---
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# --- Database (PostgreSQL + PostGIS) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=nitume_dev
DATABASE_USER=nitume
DATABASE_PASSWORD=nitume_dev_password

# --- Redis (OTP, refresh-token sessions, rate limits, cache) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Auth (JWT) ---
# Generate strong random values in non-dev environments.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- OTP ---
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RATE_LIMIT_WINDOW_SECONDS=900
OTP_RATE_LIMIT_PER_PHONE=5
# Bcrypt cost for user passwords (only used when a password is set).
BCRYPT_ROUNDS=12
# Transport for OTP delivery. `console` logs the code in dev; `africas_talking`
# sends real SMS and requires ATSMS_* credentials (never set in dev).
OTP_SENDER_TRANSPORT=console

# Africa's Talking SMS (only when OTP_SENDER_TRANSPORT=africas_talking)
# ATSMS_API_KEY=
# ATSMS_USERNAME=
# ATSMS_SENDER_ID=