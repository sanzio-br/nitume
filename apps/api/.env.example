# --- App ---
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# --- Database (PostgreSQL + PostGIS) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=nitume_dev
DATABASE_USER=nitume
DATABASE_PASSWORD=nitume_dev_password

# --- Redis (OTP, refresh-token sessions, rate limits, cache) ---
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional prefix on every app Redis key (row 224). Leave unset in dev/prod; e2e sets nitume_test:
# REDIS_KEY_PREFIX=

# --- Auth (JWT) ---
# Generate strong random values in non-dev environments.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Email (SMTP for email OTP / transactional mail) ---
# MAIL_HOST left blank → the mailer logs messages to console instead of sending.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=${APP_NAME}

# --- OTP (owner policy: 5 min expiry, 5 attempts, 60s resend, 5 codes/hour) ---
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RATE_LIMIT_WINDOW_SECONDS=3600
OTP_RATE_LIMIT_PER_PHONE=5
# Bcrypt cost for user passwords (only used when a password is set).
BCRYPT_ROUNDS=12
# Transport for OTP delivery. `console` logs the code in dev; `africas_talking`
# sends real SMS and requires ATSMS_* credentials (never set in dev).
OTP_SENDER_TRANSPORT=console

# Africa's Talking SMS (only when OTP_SENDER_TRANSPORT=africas_talking)
# ATSMS_API_KEY=
# ATSMS_USERNAME=
# ATSMS_SENDER_ID=

# --- Pricing (PLACEHOLDER rates; exact commission + runner fee percentages
# are a pending project-owner decision per the build brief §3 — the business
# plan only gives an indicative 20-25% range "to be tested"). Only the dev
# environment should use these values. ---
PRICING_SERVICE_FEE_RATE=0.20
PRICING_RUNNER_FEE_RATE=0.30

# M-Pesa provider (PAYMENTS_PROVIDER, alias PAYMENTS_MPESA_TRANSPORT).
# 'console' (default) = mock push for local/e2e. The API refuses to start
# with 'console' when NODE_ENV=production (row 89).
# 'payhero' / 'daraja' = real providers, only with owner-approved credentials.
PAYMENTS_MPESA_TRANSPORT=console
# Seconds without an STK result before the status reads TIMEOUT (not failed)
PAYMENTS_STK_TIMEOUT_SECONDS=120

# Hours a quote stays valid when the admin does not set expiresAt (row 83)
QUOTES_DEFAULT_TTL_HOURS=24

# --- Errands: urgency is derived from deadlineAt (PLACEHOLDER thresholds,
# pending owner decision) ---
ERRANDS_URGENT_WITHIN_HOURS=4
ERRANDS_SCHEDULED_AFTER_HOURS=72
# Row 221: task deadline when the customer gives none (hours after creation)
ERRANDS_DEFAULT_DEADLINE_HOURS=24
# Hours after COMPLETED before the system marks the task CONFIRMED (PLACEHOLDER)
ERRANDS_DISPUTE_WINDOW_HOURS=24

# --- Matching: an admin-made offer the runner has not accepted within this
# window expires (owner rows 114, 141: 10 minutes); the task stays
# RUNNER_ASSIGNED so the admin can offer it to another runner (row 157) ---
MATCHING_ADMIN_OFFER_WINDOW_SECONDS=600
# How often the lapsed-offer sweep runs
MATCHING_OFFER_EXPIRY_SWEEP_INTERVAL_SECONDS=30

# --- Runner location pings (§4.2, §4.3, RA-4) ---
# The app's cadence is decided (row 123); these are server-side guards.
# Row 253 (owner, 2026-10-20): at least 2 s between pings, pings older than
# 60 s refused, 100 m arrival radius.
LOCATION_PING_MIN_INTERVAL_MS=2000
LOCATION_PING_MAX_AGE_SECONDS=60
LOCATION_LIVE_TTL_SECONDS=60
LOCATION_TRAIL_EVERY_N=10
LOCATION_GEOFENCE_RADIUS_M=100
# Row 247 (owner, 2026-10-20): only job pings are stored (every Nth one, in
# runner_locations, linked to the task); idle positions stay Redis presence
# only. false keeps job pings in Redis only as well.
LOCATION_PERSIST_ENABLED=true
# Job location samples are deleted this many days after the task ends
# (SETTLED, CANCELLED, FAILED or EXPIRED), never while a dispute on the task
# is open. Daily purge time (cron, Africa/Nairobi).
LOCATION_RETENTION_DAYS=90
LOCATION_RETENTION_CRON=30 3 * * *

# --- Runner ID / selfie images (rows 154, 161-163) ---
# `console` (dev) stores nothing; production refuses to start unless this is
# `cloudinary` with the restricted ID credential below (row 162).
# RUNNER_ID_STORAGE_DRIVER=cloudinary
# Restricted Cloudinary API key used ONLY for ID images, never for task
# evidence; must differ from CLOUDINARY_API_KEY in production. Outside
# production the evidence credential is used when these are unset.
# CLOUDINARY_ID_API_KEY=
# CLOUDINARY_ID_API_SECRET=
# CLOUDINARY_ID_CLOUD_NAME=   (defaults to CLOUDINARY_CLOUD_NAME)
# Days kept after the last retention event (row 161: 12 months)
RUNNER_ID_RETENTION_DAYS=365
# Largest ID/selfie image accepted, bytes (row 163: 10 MB)
RUNNER_ID_MAX_UPLOAD_BYTES=10485760
# Row 252 (owner, 2026-10-20): largest evidence file on POST /errands/:id/evidence
# (decoded bytes; the route's JSON body limit follows). 10 MB.
EVIDENCE_MAX_UPLOAD_BYTES=10485760

# --- Runner service areas (owner row 116: ops-configured list). JSON array of
# { id, name, lat, lng, radiusKm }; `id` is a lowercase slug stored per runner.
# Unset or empty = no areas: GET /runners/service-areas lists nothing and
# PUT /runners/me/service-areas refuses every id (400 service_area_unknown),
# so a runner can pick no area until this is set.
# Areas saved before this list existed (free text, or an id later removed
# from the list) stay in runner_service_areas but are not shown on any view
# and count for nothing; the runner picks again from the list. No data
# migration. Removing an id here hides it the same way.
# Sample from the mockup only (not the real ops list):
# RUNNER_SERVICE_AREAS=[{"id":"cbd","name":"CBD","lat":-1.2864,"lng":36.8172,"radiusKm":2},{"id":"westlands","name":"Westlands","lat":-1.2676,"lng":36.8108,"radiusKm":3},{"id":"kilimani","name":"Kilimani","lat":-1.2921,"lng":36.7856,"radiusKm":2.5},{"id":"lavington","name":"Lavington","lat":-1.2800,"lng":36.7690,"radiusKm":2.5},{"id":"karen","name":"Karen","lat":-1.3190,"lng":36.7073,"radiusKm":5}]

# --- Runner payout requests: smallest amount a runner may request, KES
# (owner row 159: 500; server-side only, no admin UI) ---
MIN_RUNNER_PAYOUT_REQUEST=500

# --- Admin seed (npm run seed:admin) ---
# ADMIN_SEED_PHONE=
# ADMIN_SEED_PASSWORD=
# ADMIN_SEED_EMAIL=
# ADMIN_SEED_FULL_NAME=